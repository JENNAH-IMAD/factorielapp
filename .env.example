# Copier en .env (ignore par Git). Aucune valeur reelle dans ce fichier.
# Provide the complete SQL Server connection string for the container deployment.
SQLSERVER_CONNECTION_STRING=
ADMIN_USERNAME=admin
# Generer le hash avec scripts/Set-AdminPassword.ps1 ; utiliser des quotes simples dans .env.
ADMIN_PASSWORD_HASH=
FACTORIAL_API_KEY=
FACTORIAL_COMPANY_TOKEN=
# Development uniquement pour un essai HTTP local ; Production exige un acces HTTPS.
ASPNETCORE_ENVIRONMENT=Production
ALLOWED_HOSTS=localhost;127.0.0.1
